# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Meta Developer Portal → Your App → WhatsApp → API Setup

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=my_secure_verify_token_123

# App Secret for HMAC-SHA256 webhook signature verification.
# Meta Developer Portal → Your App → Settings → Basic → App Secret.
# REQUIRED in production – without it forged webhook requests are accepted.
WHATSAPP_APP_SECRET=your_app_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # set to "production" to enforce strict security

# ── Privacy / Compliance ──────────────────────────────────────────────────────
# Shown in the privacy notice sent to every new user (PPL §11 requirement).
# Fill in your real name and contact details before going live.
OPERATOR_NAME=Your Name or Organisation
OPERATOR_CONTACT=your@email.com

# Bump this integer whenever you materially change the privacy notice.
# All existing users will be shown the new notice and must re-consent
# before the bot processes any further messages from them.
PRIVACY_NOTICE_VERSION=1

# ── Data retention ────────────────────────────────────────────────────────────
# Number of days to retain alert-response history (default: 30).
# Older records are purged automatically on startup and once per day.
# RETENTION_DAYS=30
