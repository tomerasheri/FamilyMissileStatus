# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Found in Meta Developer Portal → Your App → WhatsApp → API Setup

# The numeric Phone Number ID (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Permanent System User Access Token (or temporary token for dev)
WHATSAPP_TOKEN=your_permanent_access_token

# A secret string YOU choose; paste the same value in the Developer Portal
# when configuring the webhook (Verify Token field).
WHATSAPP_VERIFY_TOKEN=my_secure_verify_token_123

# Your Meta App Secret – used to verify the HMAC-SHA256 signature on every
# incoming webhook POST. Found in: Meta Developer Portal → Your App → Settings → Basic.
# Without this, anyone who discovers your webhook URL can forge messages.
WHATSAPP_APP_SECRET=your_app_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Set to "production" to enforce strict security (rejects requests when
# WHATSAPP_APP_SECRET is missing instead of just warning).
NODE_ENV=development
